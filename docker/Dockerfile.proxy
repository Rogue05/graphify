# graphify egress proxy — allows builder to reach ONLY the configured LLM provider.
#
# Build:  docker build -f docker/Dockerfile.proxy -t graphify-proxy .
# The compose file builds and runs this automatically.

FROM python:3.12-alpine

# Tiny forward-proxy using only stdlib.  Validates CONNECT target and HTTP
# request URL against the single allowed hostname, drops everything else.
COPY <<"PYEOF" /proxy.py
import http.client
import http.server
import socket
import select
import os
import sys
import urllib.parse

ALLOWED_HOST = os.environ.get("ALLOWED_HOST", "").strip()
ALLOWED_PORT = int(os.environ.get("ALLOWED_PORT", "443"))
BIND = ("0.0.0.0", int(os.environ.get("PROXY_PORT", "8888")))

if not ALLOWED_HOST:
    print("FATAL: ALLOWED_HOST not set", file=sys.stderr)
    sys.exit(1)

def host_matches(target: str) -> bool:
    host = target.rsplit(":", 1)[0]
    if host == ALLOWED_HOST:
        return True
    if ALLOWED_HOST.startswith("*.") and host.endswith(ALLOWED_HOST[1:]):
        return True
    return False

class ProxyHandler(http.server.BaseHTTPRequestHandler):
    timeout = 60

    # ── CONNECT tunnel (HTTPS proxying) ──────────────────────────

    def do_CONNECT(self):
        target = self.path  # "host:port"
        if not host_matches(target):
            self.send_error(403, f"Blocked: {target}")
            print(f"BLOCK  {target}", file=sys.stderr)
            return
        print(f"ALLOW  CONNECT {target}", file=sys.stderr)
        try:
            host, port = target.rsplit(":", 1)
            port = int(port)
        except ValueError:
            self.send_error(400, f"Bad target: {target}")
            return
        try:
            remote = socket.create_connection((host, port), timeout=30)
        except OSError as e:
            self.send_error(502, f"Cannot connect to {target}: {e}")
            return
        self.send_response(200, "Connection Established")
        self.end_headers()
        self._tunnel(self.connection, remote)

    # ── HTTP proxying (GET / POST / PUT / DELETE / PATCH) ────────

    def _forward_request(self):
        parsed = urllib.parse.urlparse(self.path)
        host = parsed.hostname or ""
        port = parsed.port or 80
        target = f"{host}:{port}"
        if not host_matches(target):
            self.send_error(403, f"Blocked: {target}")
            print(f"BLOCK  {target}", file=sys.stderr)
            return
        print(f"ALLOW  {self.command} {self.path}", file=sys.stderr)
        path = parsed.path or "/"
        if parsed.query:
            path = f"{path}?{parsed.query}"
        try:
            conn = http.client.HTTPConnection(host, port, timeout=30)
            headers = {k: v for k, v in self.headers.items()
                       if k.lower() not in ("host", "proxy-connection",
                                             "proxy-authorization", "proxy-authenticate")}
            body = None
            content_len = self.headers.get("Content-Length")
            if content_len:
                body = self.rfile.read(int(content_len))
            conn.request(self.command, path, body=body, headers=headers)
            resp = conn.getresponse()
            self.send_response(resp.status, resp.reason)
            for k, v in resp.getheaders():
                if k.lower() not in ("transfer-encoding",):
                    self.send_header(k, v)
            self.end_headers()
            resp_body = resp.read()
            self.wfile.write(resp_body)
            conn.close()
        except OSError as e:
            self.send_error(502, f"Upstream error: {e}")

    def do_GET(self):     self._forward_request()
    def do_POST(self):    self._forward_request()
    def do_PUT(self):     self._forward_request()
    def do_DELETE(self):  self._forward_request()
    def do_PATCH(self):   self._forward_request()
    def do_HEAD(self):    self._forward_request()
    def do_OPTIONS(self): self._forward_request()

    # ── tunnel helper ────────────────────────────────────────────

    def _tunnel(self, client, remote):
        sockets = [client, remote]
        while True:
            r, _, _ = select.select(sockets, [], [], 60)
            if not r:
                break
            for sock in r:
                data = sock.recv(65536)
                if not data:
                    return
                peer = remote if sock is client else client
                try:
                    peer.sendall(data)
                except OSError:
                    return

if __name__ == "__main__":
    print(f"proxy: allowing only {ALLOWED_HOST}:{ALLOWED_PORT} on port {BIND[1]}",
          file=sys.stderr)
    server = http.server.ThreadingHTTPServer(BIND, ProxyHandler)
    server.serve_forever()
PYEOF

RUN chmod +x /proxy.py \
    && adduser -D -u 10001 proxy

USER proxy

ENTRYPOINT ["python", "/proxy.py"]
