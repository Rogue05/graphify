# ── graphify builder credentials ─────────────────────────────────
# Copy this file to docker/.env and fill in your values.
# NEVER commit docker/.env.

# OpenAI-compatible API key (REQUIRED)
OPENAI_API_KEY=sk-your-key-here

# ── Egress proxy — whitelist the provider host ───────────────────
# The proxy allows CONNECT tunnels ONLY to this host:port.
# Extract the hostname from OPENAI_BASE_URL (no https://, no path).
#   https://api.openai.com/v1          → api.openai.com
#   https://my-llm.internal:8000/v1    → my-llm.internal
PROXY_ALLOWED_HOST=localhost
PROXY_ALLOWED_PORT=11434

# Base URL for your OpenAI-compatible endpoint.
# Defaults to api.openai.com.  Set this to your own server:
#   vLLM:         http://your-host:8000/v1
#   LiteLLM:      http://your-host:4000/v1
#   llama.cpp:    http://your-host:8080/v1
#   LM Studio:    http://your-host:1234/v1
OPENAI_BASE_URL=https://${PROXY_ALLOWED_HOST}:/v1

# Model name (optional — defaults to gpt-4.1-mini)
OPENAI_MODEL=gemma4

# ── Project paths ────────────────────────────────────────────────
# Absolute path to the project repo (for extraction).
# Default: the graphify repo itself.  Set to another project when
# using the builder there.
GRAPHIFY_REPO_DIR=D:\nauka\graphify

# Absolute path to graphify-out/ (for the MCP server).
# Default: graphify-out/ inside the graphify repo.  Set to another
# project's output when serving a different graph.
GRAPHIFY_OUT_DIR=${GRAPHIFY_REPO_DIR}\graphify-out

# ── Resource limits ──────────────────────────────────────────────
BUILDER_MEMORY=2G
BUILDER_CPUS=2.0
SERVER_MEMORY=512M
SERVER_CPUS=1.0

# ── MCP server port ──────────────────────────────────────────────
SERVER_PORT=8080

# ── Graphify tuning (optional) ───────────────────────────────────
# GRAPHIFY_MAX_WORKERS=1
# GRAPHIFY_MAX_OUTPUT_TOKENS=16384
# GRAPHIFY_API_TIMEOUT=600
# GRAPHIFY_DISABLE_THINKING=0
